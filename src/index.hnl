--- kv_map — a pure functional key-value map. The store is a Handl record
--- VALUE you hold and pass back — `kv_map.new() -> s`, `kv_map.set(s,k,v)
--- -> s'`, `kv_map.get(s,k)` — state is explicit data, not ambient module
--- state like `kv`/`kv_hashmap` (which stay native). Pure `.hnl` over
--- `obj.*` substrate + record field access.
cap "kv_map.new"
cap "kv_map.set"
cap "kv_map.get"
cap "kv_map.has"
cap "kv_map.remove"
cap "kv_map.clear"
cap "kv_map.size"
cap "kv_map.keys"
op "kv_map.new" : () ~> Value
  guarantee: True
op "kv_map.set" : (Value * Value * Value) ~> Value
  guarantee: True
op "kv_map.get" : (Value * Value) ~> Value
  guarantee: True
op "kv_map.has" : (Value * Value) ~> Value
  guarantee: True
op "kv_map.remove" : (Value * Value) ~> Value
  guarantee: True
op "kv_map.clear" : Value ~> Value
  guarantee: True
op "kv_map.size" : Value ~> Value
  guarantee: True
op "kv_map.keys" : Value ~> Value
  guarantee: True

from "obj" import * as obj

do {
  len := (xs) ~> while { xs: xs, n: 0 } {
    [xs, n] ~> match xs {
      []: { out: n },
      [_, ...t]: { state: { xs: t, n: n + 1 } }
    }
  }

  hit := (xs, k) ~> while { xs: xs, found: false } {
    [xs, found] ~> match xs {
      []: { out: found },
      [x, ...t]: { state: { xs: t, found: if x == k { true } else { found } } }
    }
  }

  drop_k := (xs, k) ~> while { xs: xs, out: [] } {
    [xs, out] ~> match xs {
      []: { out: out },
      [e, ...t]: { state: { xs: t, out: if e[0] == k { out } else { [...out, e] } } }
    }
  }

  { new: () ~> ({}),
    set: (s, k, v) ~> obj.set(s, k, v),
    get: (s, k) ~> s[k],
    has: (s, k) ~> hit(obj.keys(s), k),
    remove: (s, k) ~> obj.from_entries(drop_k(obj.entries(s), k)),
    clear: (s) ~> ({}),
    size: (s) ~> len(obj.keys(s)),
    keys: (s) ~> obj.keys(s) }
}
